# ─── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_PREFIX=api

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/rwf_miner?schema=public"

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-too-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password
MAIL_FROM="RWF Miner <noreply@rwfminer.com>"

# ─── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Throttle ──────────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
